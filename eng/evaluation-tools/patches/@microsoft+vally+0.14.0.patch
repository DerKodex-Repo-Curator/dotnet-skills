+// Backport microsoft/vally#1109 without changing the 0.14 evaluation schema.
+async function publishAndReleaseSession(session, client, rootDir, deleteCreatedSessionAfterExport, timeoutMs) {
+    const published = await persistSessionHistory(session, rootDir, timeoutMs);
+    const disconnected = await runBoundedCleanup(() => session.disconnect(), timeoutMs);
+    if (!disconnected)
+        console.warn("Vally session disconnect failed or timed out.");
+    if (published && deleteCreatedSessionAfterExport) {
+        const deleted = await runBoundedCleanup(() => client.deleteSession(session.sessionId), timeoutMs);
+        if (!deleted)
+            console.warn("Vally exported session cleanup failed or timed out.");
+    }
+}
+async function persistSessionHistory(session, rootDir, timeoutMs) {
+    if (!rootDir)
+        return false;
+    const events = await getSessionEventsWithin(session, timeoutMs);
+    if (!events || events.length === 0) {
+        console.warn("Vally session history unavailable; retaining SDK session and using raw-event fallback.");
+        return false;
+    }
+    const eventsPath = path.join(rootDir, "events.jsonl");
+    const tempPath = path.join(rootDir, `.events-${crypto.randomUUID()}.tmp`);
+    let handle;
+    try {
+        handle = await open(tempPath, "wx");
+        for (const event of events) {
+            const line = JSON.stringify(event);
+            if (line === undefined)
+                throw new TypeError("Session event is not JSON-serializable");
+            await handle.writeFile(`${line}\n`, "utf8");
+        }
+        await handle.close();
+        handle = undefined;
+        await rename(tempPath, eventsPath);
+        return true;
+    }
+    catch {
+        console.warn("Vally session history export failed; retaining SDK session and using raw-event fallback.");
+        return false;
+    }
+    finally {
+        if (handle)
+            await handle.close().catch(() => undefined);
+        await rm(tempPath, { force: true }).catch(() => undefined);
+    }
+}
+async function getSessionEventsWithin(session, timeoutMs) {
+    let timer;
+    const retrieval = Promise.resolve()
+        .then(() => session.getEvents())
+        .then((events) => events, () => undefined);
+    try {
+        return await Promise.race([
+            retrieval,
+            new Promise((resolve) => {
+                timer = setTimeout(() => resolve(undefined), timeoutMs);
+            }),
+        ]);
+    }
+    finally {
+        if (timer)
+            clearTimeout(timer);
+    }
+}
